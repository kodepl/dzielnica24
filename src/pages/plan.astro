---

<Atlas
  title="Plan 20 tematów"
  description="Dwudziestka oryginalnych tematów Dzielnica24 pogrupowanych w pięć klastrów dzielnic."
  canonicalPath="/plan/"
>
  <div class="shell page-hero">
    <h1>Plan 20 tematów</h1>
    <p>
      Klastry odpowiadają dzielnicom atlasu. To mapa rozwoju, nie obietnica dat publikacji.
    </p>
  </div>
  <div class="shell section prose" style="max-width:46rem">
    {
      clusters.map((c) => (
        <>
          <h2>{c.name}</h2>
          <ol>
            {c.items.map((t) => (
              <li>{t}</li>
            ))}
          </ol>
        </>
      ))
    }
  </div>
</Atlas>
